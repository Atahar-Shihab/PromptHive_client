# Required for API calls and production uploaded image rendering.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional. Leave empty to use the current frontend origin and the /api/auth proxy.
# For production, this should normally be https://your-vercel-domain.vercel.app
NEXT_PUBLIC_AUTH_URL=

# Optional. Leave empty to use the frontend /api proxy for all API requests.
# Only set this when you intentionally want the browser to call the server directly.
NEXT_PUBLIC_REQUEST_API_URL=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
